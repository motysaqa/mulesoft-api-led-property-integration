<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic WSDL for a fictional legacy rates system.
  Document/literal wrapped, which is what the Web Service Consumer connector
  handles best and what most 2000s-era .NET/Java rate engines actually emit.
-->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="http://legacy.rates.portfolio.com/"
                  targetNamespace="http://legacy.rates.portfolio.com/"
                  name="LegacyRatesService">

  <wsdl:types>
    <xsd:schema targetNamespace="http://legacy.rates.portfolio.com/"
                elementFormDefault="qualified">

      <xsd:element name="GetRates">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PropertyId"   type="xsd:string"/>
            <xsd:element name="RatePlanCode" type="xsd:string"/>
            <xsd:element name="FromDate"     type="xsd:date"/>
            <xsd:element name="ToDate"       type="xsd:date"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetRatesResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="PropertyId"   type="xsd:string"/>
            <xsd:element name="RatePlanCode" type="xsd:string"/>
            <xsd:element name="Currency"     type="xsd:string"/>
            <xsd:element name="DailyRates"   type="tns:DailyRateList"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="DailyRateList">
        <xsd:sequence>
          <xsd:element name="DailyRate" type="tns:DailyRate" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="DailyRate">
        <xsd:sequence>
          <xsd:element name="Date"          type="xsd:date"/>
          <!-- Legacy quirk: amounts are minor units (cents) as an integer. -->
          <xsd:element name="AmountMinor"   type="xsd:long"/>
          <xsd:element name="TaxIncluded"   type="xsd:boolean"/>
          <xsd:element name="PromotionCode" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="RatesFault">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Code"    type="xsd:string"/>
            <xsd:element name="Message" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="GetRatesRequest">
    <wsdl:part name="parameters" element="tns:GetRates"/>
  </wsdl:message>
  <wsdl:message name="GetRatesResponse">
    <wsdl:part name="parameters" element="tns:GetRatesResponse"/>
  </wsdl:message>
  <wsdl:message name="RatesFaultMessage">
    <wsdl:part name="fault" element="tns:RatesFault"/>
  </wsdl:message>

  <wsdl:portType name="LegacyRatesPortType">
    <wsdl:operation name="GetRates">
      <wsdl:input  message="tns:GetRatesRequest"/>
      <wsdl:output message="tns:GetRatesResponse"/>
      <wsdl:fault name="RatesFault" message="tns:RatesFaultMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="LegacyRatesBinding" type="tns:LegacyRatesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="GetRates">
      <soap:operation soapAction="http://legacy.rates.portfolio.com/GetRates" style="document"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="RatesFault"><soap:fault name="RatesFault" use="literal"/></wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="LegacyRatesService">
    <wsdl:port name="LegacyRatesPort" binding="tns:LegacyRatesBinding">
      <soap:address location="http://localhost:5082/LegacyRatesService"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
