<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">

  <!-- mule.env selects the property file; secure.key is passed as a JVM arg and never stored. -->
  <global-property name="mule.env" value="dev"/>
  <configuration-properties file="config-${mule.env}.yaml" doc:name="Environment properties"/>

  <!--
    Secure properties are deliberately NOT wired up in this repo.

    Enabling the block below requires an encrypted config-secure-dev.yaml and a
    runtime key passed as -M-Dsecure.key=..., neither of which can live in a public
    repository. Shipping it inactive keeps `mvn clean package` and a Studio run
    working from a fresh clone. docs/setup.md, "Secret management", has the exact
    secure-properties-tool commands and the CloudHub/Studio wiring.

    <secure-properties:config name="secure-properties-config"
                              key="${secure.key}"
                              file="config-secure-${mule.env}.yaml">
      <secure-properties:encrypt algorithm="Blowfish" mode="CBC"/>
    </secure-properties:config>
  -->

  <configuration defaultErrorHandler-ref="global-error-handler" doc:name="Runtime configuration"/>

  <http:listener-config name="http-listener-config" doc:name="HTTP Listener">
    <http:listener-connection host="${http.host}" port="${http.port}"/>
  </http:listener-config>

  <http:request-config name="property-backend-request-config" doc:name="Property backend">
    <http:request-connection protocol="${property.backend.protocol}"
                             host="${property.backend.host}"
                             port="${property.backend.port}"
                             connectionIdleTimeout="30000"/>
    <http:default-headers>
      <http:default-header key="Accept" value="application/json"/>
      <!-- Propagate the correlation id downstream so one request id spans all three layers. -->
      <http:default-header key="X-Correlation-ID" value="#[correlationId]"/>
    </http:default-headers>
  </http:request-config>

  <!--
    Structured error responses. Every layer returns the same envelope so the
    channel manager never sees a Mule stack trace or an HTML error page.
  -->
  <error-handler name="global-error-handler" doc:name="Global error handler">

    <on-error-propagate type="PROPERTY:NOT_FOUND" enableNotifications="true" logException="false"
                        doc:name="404 Not found">
      <ee:transform doc:name="Not found envelope">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "PROPERTY_NOT_FOUND",
    message: error.description default "The requested property does not exist",
    layer: "system-property-api",
    correlationId: correlationId,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"}
  }
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
          <ee:set-variable variableName="httpStatus">404</ee:set-variable>
        </ee:variables>
      </ee:transform>
    </on-error-propagate>

    <on-error-propagate type="HTTP:TIMEOUT, HTTP:CONNECTIVITY, HTTP:RETRY_EXHAUSTED, RETRY_EXHAUSTED"
                        logException="true" doc:name="502 Backend unavailable">
      <logger level="ERROR" doc:name="Log backend failure"
              message='#[output application/json --- { event: "backend_unavailable", correlationId: correlationId, errorType: error.errorType.identifier default "UNKNOWN", detail: error.description default "" }]'/>
      <ee:transform doc:name="Backend unavailable envelope">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "BACKEND_UNAVAILABLE",
    message: "The property backend did not respond in time. Retry with backoff.",
    layer: "system-property-api",
    correlationId: correlationId,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"}
  }
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
          <ee:set-variable variableName="httpStatus">502</ee:set-variable>
        </ee:variables>
      </ee:transform>
    </on-error-propagate>

    <on-error-propagate type="EXPRESSION, VALIDATION:INVALID_INPUT, PROPERTY:BAD_REQUEST"
                        logException="false" doc:name="400 Bad request">
      <ee:transform doc:name="Bad request envelope">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "BAD_REQUEST",
    message: error.description default "The request could not be understood",
    layer: "system-property-api",
    correlationId: correlationId,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"}
  }
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
          <ee:set-variable variableName="httpStatus">400</ee:set-variable>
        </ee:variables>
      </ee:transform>
    </on-error-propagate>

    <on-error-propagate type="ANY" logException="true" doc:name="500 Unexpected">
      <logger level="ERROR" doc:name="Log unexpected error"
              message='#[output application/json --- { event: "unhandled_error", correlationId: correlationId, errorType: error.errorType.asString default "UNKNOWN", detail: error.description default "" }]'/>
      <ee:transform doc:name="Internal error envelope">
        <ee:message>
          <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: {
    code: "INTERNAL_ERROR",
    // Deliberately generic: never leak stack traces or backend hostnames to a caller.
    message: "An unexpected error occurred while processing the request",
    layer: "system-property-api",
    correlationId: correlationId,
    timestamp: now() as String {format: "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"}
  }
}]]></ee:set-payload>
        </ee:message>
        <ee:variables>
          <ee:set-variable variableName="httpStatus">500</ee:set-variable>
        </ee:variables>
      </ee:transform>
    </on-error-propagate>

  </error-handler>
</mule>
