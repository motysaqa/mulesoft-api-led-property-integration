<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.portfolio.property</groupId>
  <artifactId>api-led-property-integration</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>API-led Property Integration (aggregator)</name>

  <modules>
    <module>system-property-api</module>
    <module>system-legacy-rates-soap-api</module>
    <module>process-availability-pricing-api</module>
    <module>experience-booking-channel-api</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <app.runtime>4.6.0</app.runtime>
    <mule.maven.plugin.version>4.1.1</mule.maven.plugin.version>
    <munit.version>3.1.0</munit.version>
    <http.connector.version>1.9.3</http.connector.version>
    <sockets.connector.version>1.2.5</sockets.connector.version>
    <apikit.version>1.11.3</apikit.version>
    <wsc.connector.version>1.8.4</wsc.connector.version>
    <objectstore.connector.version>1.2.2</objectstore.connector.version>
    <secure.props.version>1.2.5</secure.props.version>
  </properties>

  <!--
    MuleSoft artifacts are hosted on the Anypoint Exchange / MuleSoft EE repositories.
    The EE repository requires credentials (see docs/setup.md, "Maven settings.xml").
    Without them `mvn test` cannot resolve the Mule runtime and MUnit plugins.
  -->
  <repositories>
    <repository>
      <id>anypoint-exchange-v3</id>
      <name>Anypoint Exchange</name>
      <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
      <layout>default</layout>
    </repository>
    <repository>
      <id>mulesoft-public</id>
      <name>MuleSoft Public Repository</name>
      <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
      <layout>default</layout>
    </repository>
    <repository>
      <id>mule-ee-releases</id>
      <name>MuleSoft EE Releases</name>
      <url>https://repository.mulesoft.org/nexus-ee/content/repositories/releases-ee/</url>
      <layout>default</layout>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>mulesoft-public</id>
      <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
    </pluginRepository>
    <pluginRepository>
      <id>mule-ee-releases</id>
      <url>https://repository.mulesoft.org/nexus-ee/content/repositories/releases-ee/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
