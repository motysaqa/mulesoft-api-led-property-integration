{
  "timestamp": { "$resolver": "timestamp", "pattern": { "format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX" } },
  "level": { "$resolver": "level", "field": "name" },
  "logger": { "$resolver": "logger", "field": "name" },
  "thread": { "$resolver": "thread", "field": "name" },
  "message": { "$resolver": "message", "stringified": false },
  "application": "${sys:app.name:-unknown}",
  "exception": {
    "type": { "$resolver": "exception", "field": "className" },
    "message": { "$resolver": "exception", "field": "message" },
    "stackTrace": { "$resolver": "exception", "field": "stackTrace", "stackTrace": { "stringified": true } }
  }
}
