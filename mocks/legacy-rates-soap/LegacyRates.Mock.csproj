<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LegacyRates.Mock</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same WSDL the Mule app packages, served at ?wsdl so the connector can be
         pointed at either copy while troubleshooting. -->
    <Content Include="..\..\system-legacy-rates-soap-api\src\main\resources\wsdl\LegacyRatesService.wsdl"
             Link="wsdl\LegacyRatesService.wsdl"
             CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
