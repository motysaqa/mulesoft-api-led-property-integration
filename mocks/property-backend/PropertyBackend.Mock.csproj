<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PropertyBackend.Mock</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK already globs data\properties.json as Content; this only marks it
         for copy. Using Include here would make it a duplicate item (NETSDK1022). -->
    <Content Update="data\properties.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
